NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=true
PORT=3000
PUBLIC_API_BASE_URL=https://api.review.example.com
DATABASE_URL=postgresql://ai_review:replace-with-strong-password@postgres.internal:5432/ai_review?schema=public&sslmode=require
DIRECT_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
REDIS_URL=rediss://:replace-with-strong-password@redis.internal:6379/0
CORS_ORIGINS=https://h5.example.cn
LOG_LEVEL=info
ENABLE_API_DOCS=false
AI_PROVIDER=zhipu
DEFAULT_AI_PROVIDER=zhipu
DEEPSEEK_API_KEY=replace-with-server-side-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=12000
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_TIMEOUT_MS=12000
GLOBAL_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=20
SESSION_CLEANUP_INTERVAL_MS=3600000
ADMIN_API_KEY=replace-with-long-random-admin-key
CONTENT_BLOCKLIST=刷单,返现,代写
