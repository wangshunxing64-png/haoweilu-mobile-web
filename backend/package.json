{
  "name": "ai-restaurant-review-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run test:domain && npm run test:api",
    "test:domain": "node --experimental-strip-types --test tests/domain/*.test.ts",
    "test:api": "node --experimental-strip-types --test tests/api/*.test.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:bootstrap": "prisma generate && prisma migrate deploy && prisma db seed",
    "loadtest:local": "node ops/load-test.mjs",
    "backup:postgres": "sh ops/backup-postgres.sh",
    "verify": "npm run test:domain && npm run test:api && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "ioredis": "5.11.1",
    "openai": "^7.4.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "prisma": "7.9.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
